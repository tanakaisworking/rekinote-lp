---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { TeamPlanApplicationForm } from "../../../components/react/TeamPlanApplicationForm";

const tools = [
  { name: "Google Meet", icon: "/lp/team/tool-google-meet.svg" },
  { name: "Zoom", icon: "/lp/team/tool-zoom.svg" },
  { name: "Teams", icon: "/lp/team/tool-teams.svg" },
  { name: "Slack", icon: "/lp/team/tool-slack.svg" },
  { name: "1on1", icon: "/lp/team/tool-1on1.svg" },
];

const pipeline = [
  { label: "会話", icon: "/lp/team/icon-capture.svg", text: "会議・通話・1on1" },
  { label: "ローカル 文字起こし", icon: "/lp/team/icon-local.svg", text: "PC内で処理" },
  { label: "要約承認", icon: "/lp/team/icon-summary.svg", text: "共有範囲を選ぶ" },
  { label: "ダッシュボード", icon: "/lp/team/icon-dashboard.svg", text: "論点と進捗を見る" },
  { label: "生成AI", icon: "/lp/team/icon-ai.svg", text: "承認済みデータを接続" },
];

const proofs = [
  { title: "ツールを選ばない", body: "Meet、Zoom、Teams、Slack、対面まで。会議ツールごとの制約から離れます。", icon: "/lp/team/feature-tools.svg" },
  { title: "秘密情報に強い", body: "録音・文字起こしをローカルに残し、必要な要約だけを組織へ提出できます。", icon: "/lp/team/feature-privacy.svg" },
  { title: "経営が見える", body: "未決論点、担当未設定、KPI遅れを、会話から経営の確認対象に変えます。", icon: "/lp/team/feature-data.svg" },
];

const pricingBullets = ["文字起こし・要約", "未決論点・アクション管理", "KPIモニタリング", "権限管理・監査ログ", "ローカル運用・NDA対応"];
---

<BaseLayout
  title="Reki note Team — 社内の会話を、AIが使える経営資産に。"
  description="Reki note Teamは、会議・通話・1on1を要約し、経営と生成AIにつながる会話データ基盤をつくるチーム向けサービスです。"
  lang="ja"
  canonical="https://rekinote.app/ja/lp/team/"
  singleLang
>
  <main class="team-page">
    <header class="team-header">
      <a href="/ja/lp/" class="team-logo" aria-label="Reki note">
        <img src="/logo.png" alt="" width="28" height="28" />
        <span>Reki note</span>
        <strong>Team</strong>
      </a>
      <nav aria-label="ページ内ナビゲーション">
        <a href="#product">機能</a>
        <a href="#security">セキュリティ</a>
        <a href="#pricing">料金</a>
      </nav>
      <a href="#apply" class="team-header-cta">チーム導入を相談する</a>
    </header>

    <section class="team-hero">
      <div class="team-hero-copy">
        <p class="team-kicker">Reki note Team</p>
        <h1>
          <span>社内の会話を、</span>
          <em>AIが使える</em>
          <span>経営資産に。</span>
        </h1>
        <p class="team-lead">会議・通話・1on1を要約し、経営と生成AIにつながるデータ基盤をつくる。</p>
        <div class="team-actions">
          <a href="#apply" class="team-primary">チーム導入を相談する</a>
          <a href="#security" class="team-secondary">セキュリティを見る</a>
        </div>
        <div class="team-trust" aria-label="導入時の安心材料">
          <span>ローカル運用</span>
          <span>NDA締結</span>
          <span>権限管理</span>
        </div>
        <div class="team-tools" aria-label="対応ツール">
          {tools.map((tool) => (
            <span>
              <img src={tool.icon} alt="" width="24" height="24" loading="eager" />
              {tool.name}
            </span>
          ))}
        </div>
      </div>

      <div class="team-pipeline-hero" aria-label="会話から生成AIまでの流れ">
        {pipeline.map((step, index) => (
          <article>
            <img src={step.icon} alt="" width="48" height="48" loading="eager" />
            <b>{step.label}</b>
            <p>{step.text}</p>
            {index < pipeline.length - 1 && <span class="team-arrow">→</span>}
          </article>
        ))}
      </div>
    </section>

    <section class="team-proof" id="product" aria-labelledby="proof-title">
      <div class="team-section-heading">
        <p>VALUE</p>
        <h2 id="proof-title">見るべき価値は、3つだけ。</h2>
      </div>
      <div class="team-proof-grid">
        {proofs.map((proof) => (
          <article>
            <img src={proof.icon} alt="" width="360" height="180" loading="eager" />
            <h3>{proof.title}</h3>
            <p>{proof.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="team-security" id="security" aria-labelledby="security-title">
      <div class="team-section-heading">
        <p>SECURITY</p>
        <h2 id="security-title">データは、必要なときだけ組織へ。</h2>
        <span>ローカル処理とクラウド共有の境界を分け、秘密情報とAI活用を両立します。</span>
      </div>
      <div class="team-security-flow">
        <img src="/lp/team/security-boundary.svg" alt="" width="1120" height="280" loading="eager" />
      </div>
      <div class="team-security-points">
        <span>音声はローカル保持</span>
        <span>要約を承認して共有</span>
        <span>AI連携は承認済みデータのみ</span>
      </div>
    </section>

    <section class="team-pricing" id="pricing" aria-labelledby="pricing-title">
      <div class="team-section-heading align-left">
        <p>PRICING</p>
        <h2 id="pricing-title">AI Readyな組織へ。</h2>
      </div>
      <div class="team-price-panel">
        <article class="team-price-card">
          <span>Team</span>
          <h3><b>¥5,000</b> / 席 / 月</h3>
          <ul>
            {pricingBullets.map((item) => <li>{item}</li>)}
          </ul>
        </article>
        <article class="team-consult-card">
          <span>オンラインで実施</span>
          <h3>まずは30分相談</h3>
          <p>貴社の会議・セキュリティ要件に合わせて、導入方法をご提案します。</p>
          <a href="#apply" class="team-primary">まずは30分相談</a>
        </article>
      </div>
    </section>

    <section class="team-application" id="apply" aria-labelledby="apply-title">
      <div class="team-application-copy">
        <p class="team-kicker">APPLICATION</p>
        <h2 id="apply-title">チーム導入を相談する</h2>
        <p>想定人数と導入目的だけお送りください。必要な契約・運用条件を整理してご案内します。</p>
      </div>
      <TeamPlanApplicationForm client:load />
    </section>
  </main>
</BaseLayout>

<style>
  .team-page {
    --ink: #0b0d14;
    --muted: #5d6675;
    --line: rgba(11, 13, 20, 0.12);
    --purple: #7c3aed;
    --purple-dark: #4c1d95;
    min-height: 100vh;
    background: #fafafa;
    color: var(--ink);
    line-break: strict;
  }

  .team-page *,
  .team-page *::before,
  .team-page *::after {
    box-sizing: border-box;
  }

  .team-header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 64px;
    padding: 0 44px;
    border-bottom: 1px solid var(--line);
    background: rgba(250, 250, 250, 0.9);
    backdrop-filter: blur(16px);
  }

  .team-logo,
  .team-header nav,
  .team-header-cta,
  .team-primary,
  .team-secondary {
    display: inline-flex;
    align-items: center;
  }

  .team-logo {
    gap: 10px;
    color: var(--ink);
    font-weight: 800;
    text-decoration: none;
  }

  .team-logo img {
    border-radius: 7px;
  }

  .team-logo strong {
    padding: 2px 8px;
    border-radius: 6px;
    background: var(--purple);
    color: #fff;
    font-size: 12px;
  }

  .team-header nav {
    gap: 32px;
    font-size: 14px;
    font-weight: 800;
  }

  .team-header nav a,
  .team-secondary {
    color: #293241;
    text-decoration: none;
  }

  .team-header-cta,
  .team-primary {
    justify-content: center;
    border-radius: 8px;
    background: var(--purple);
    color: #fff;
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0 18px 38px -24px rgba(124, 58, 237, 0.9);
  }

  .team-header-cta {
    min-height: 42px;
    padding: 0 18px;
    font-size: 14px;
  }

  .team-primary,
  .team-secondary {
    min-height: 56px;
    padding: 0 26px;
    font-size: 16px;
  }

  .team-secondary {
    border-bottom: 1px solid rgba(124, 58, 237, 0.35);
    font-weight: 800;
  }

  .team-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(580px, 1fr);
    gap: 48px;
    align-items: center;
    max-width: 1280px;
    margin: 0 auto;
    padding: 92px 40px 72px;
  }

  .team-kicker,
  .team-section-heading p {
    margin: 0;
    color: var(--purple);
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .team-hero h1 {
    margin: 22px 0 0;
    font-size: clamp(48px, 5.5vw, 76px);
    letter-spacing: -0.045em;
    line-height: 1.04;
  }

  .team-hero h1 em {
    display: block;
    color: var(--purple);
    font-style: normal;
  }

  .team-hero h1 span {
    display: block;
    white-space: nowrap;
  }

  .team-lead {
    max-width: 520px;
    margin: 26px 0 0;
    color: #333b49;
    font-size: 19px;
    font-weight: 600;
    line-height: 1.9;
  }

  .team-actions,
  .team-trust,
  .team-tools,
  .team-security-points {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .team-actions {
    margin-top: 34px;
    gap: 18px;
  }

  .team-trust {
    margin-top: 26px;
  }

  .team-trust span,
  .team-security-points span {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 14px;
    border: 1px solid rgba(22, 101, 52, 0.18);
    border-radius: 8px;
    background: rgba(22, 163, 74, 0.06);
    color: #166534;
    font-size: 13px;
    font-weight: 800;
  }

  .team-tools {
    margin-top: 28px;
  }

  .team-tools span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 48px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fff;
    color: #2f3847;
    font-size: 13px;
    font-weight: 800;
  }

  .team-tools img {
    width: 24px;
    height: 24px;
    object-fit: contain;
  }

  .team-pipeline-hero {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    min-height: 560px;
    border: 1px solid rgba(124, 58, 237, 0.12);
    border-radius: 10px;
    background: linear-gradient(90deg, rgba(124, 58, 237, 0.04), #fff 22%, rgba(124, 58, 237, 0.045));
    overflow: hidden;
  }

  .team-pipeline-hero article {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 18px;
    padding: 30px 22px;
    border-right: 1px solid rgba(124, 58, 237, 0.1);
  }

  .team-pipeline-hero article:last-child {
    border-right: 0;
  }

  .team-pipeline-hero img {
    width: 56px;
    height: 56px;
    border-radius: 12px;
  }

  .team-pipeline-hero b {
    font-size: 20px;
    line-height: 1.4;
  }

  .team-pipeline-hero p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.75;
  }

  .team-arrow {
    position: absolute;
    right: -14px;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1px solid rgba(124, 58, 237, 0.18);
    border-radius: 99px;
    background: #fff;
    color: var(--purple);
    font-weight: 900;
  }

  .team-proof,
  .team-security,
  .team-pricing,
  .team-application {
    padding: 74px max(32px, calc((100vw - 1180px) / 2 + 32px));
  }

  .team-section-heading {
    max-width: 760px;
    margin: 0 auto 34px;
    text-align: center;
  }

  .team-section-heading.align-left {
    margin-left: 0;
    text-align: left;
  }

  .team-section-heading h2,
  .team-application h2 {
    margin: 12px 0 0;
    font-size: clamp(36px, 4.2vw, 58px);
    letter-spacing: -0.035em;
    line-height: 1.18;
    text-wrap: balance;
  }

  .team-section-heading span,
  .team-application-copy p {
    display: block;
    margin-top: 16px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.9;
  }

  .team-proof {
    background: #fff;
  }

  .team-proof-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .team-proof-grid article {
    padding: 30px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fff;
  }

  .team-proof-grid img {
    display: block;
    width: 100%;
    height: 160px;
    border: 1px solid rgba(11, 13, 20, 0.08);
    border-radius: 8px;
    object-fit: cover;
    background: #f8fafc;
  }

  .team-proof-grid h3 {
    margin: 26px 0 0;
    font-size: 28px;
    line-height: 1.35;
  }

  .team-proof-grid p {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.85;
  }

  .team-security {
    background: linear-gradient(180deg, #f4f0ff 0%, #fff 100%);
  }

  .team-security-flow {
    max-width: 1120px;
    margin: 0 auto;
    border: 1px solid rgba(124, 58, 237, 0.14);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.76);
    overflow: hidden;
  }

  .team-security-flow img {
    display: block;
    width: 100%;
    height: auto;
  }

  .team-security-points {
    justify-content: center;
    margin-top: 22px;
  }

  .team-pricing {
    background: #fff;
  }

  .team-price-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    max-width: 980px;
    margin: 0 auto;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #fff;
    overflow: hidden;
    box-shadow: 0 30px 80px -60px rgba(15, 23, 42, 0.8);
  }

  .team-price-card,
  .team-consult-card {
    padding: 42px;
  }

  .team-price-card {
    border-right: 1px solid var(--line);
  }

  .team-price-card > span,
  .team-consult-card > span {
    color: var(--purple);
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 12px;
    font-weight: 800;
  }

  .team-price-card h3,
  .team-consult-card h3 {
    margin: 14px 0 0;
    font-size: 30px;
    letter-spacing: -0.02em;
  }

  .team-price-card h3 b {
    color: var(--purple);
    font-size: clamp(48px, 5vw, 70px);
  }

  .team-price-card ul {
    padding: 0;
    margin: 28px 0 0;
    list-style: none;
  }

  .team-price-card li {
    position: relative;
    padding-left: 24px;
    margin-top: 14px;
    color: #333b49;
    font-weight: 700;
  }

  .team-price-card li::before {
    content: "";
    position: absolute;
    top: 0.65em;
    left: 2px;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--purple);
  }

  .team-consult-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }

  .team-consult-card p {
    max-width: 460px;
    margin: 18px 0 30px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.9;
  }

  .team-application {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: 36px;
    align-items: start;
    background: #f7f7f8;
    padding-bottom: 96px;
  }

  :global(.team-form) {
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fff;
  }

  :global(.team-form-grid) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  :global(.team-form label) {
    display: block;
  }

  :global(.team-form span) {
    display: block;
    color: #374151;
    font-size: 13px;
    font-weight: 800;
  }

  :global(.team-form input),
  :global(.team-form select),
  :global(.team-form textarea) {
    width: 100%;
    margin-top: 8px;
    border: 1px solid rgba(17, 18, 24, 0.16);
    border-radius: 8px;
    background: #fff;
    color: #111827;
    font: inherit;
    font-size: 15px;
    outline: none;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }

  :global(.team-form input),
  :global(.team-form select) {
    height: 48px;
    padding: 0 13px;
  }

  :global(.team-form textarea) {
    resize: vertical;
    padding: 12px 13px;
    line-height: 1.7;
  }

  :global(.team-form input:focus),
  :global(.team-form select:focus),
  :global(.team-form textarea:focus) {
    border-color: rgba(124, 58, 237, 0.62);
    box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.12);
  }

  :global(.team-form-message) {
    margin-top: 16px;
  }

  :global(.team-form-honeypot) {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  :global(.team-form-actions) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 22px;
  }

  :global(.team-form-actions p) {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.8;
  }

  :global(.team-form-actions button) {
    flex: 0 0 auto;
    min-height: 48px;
    border: 0;
    border-radius: 8px;
    background: var(--purple);
    color: #fff;
    cursor: pointer;
    font: inherit;
    font-weight: 800;
    padding: 0 20px;
  }

  :global(.team-form-actions button:disabled) {
    cursor: wait;
    opacity: 0.7;
  }

  :global(.team-form-success),
  :global(.team-form-error) {
    margin-top: 16px;
    border-radius: 8px;
    padding: 13px 14px;
    font-size: 13px;
    font-weight: 700;
  }

  :global(.team-form-success) {
    background: rgba(22, 163, 74, 0.1);
    color: #166534;
  }

  :global(.team-form-error) {
    background: rgba(220, 38, 38, 0.1);
    color: #991b1b;
  }

  @media (max-width: 1080px) {
    .team-header {
      padding: 0 22px;
    }

    .team-header nav {
      display: none;
    }

    .team-hero,
    .team-price-panel,
    .team-application {
      grid-template-columns: 1fr;
    }

    .team-hero {
      padding-left: 24px;
      padding-right: 24px;
    }

    .team-pipeline-hero {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .team-pipeline-hero article {
      min-height: 150px;
      border-right: 0;
      border-bottom: 1px solid rgba(124, 58, 237, 0.1);
    }

    .team-pipeline-hero article:last-child {
      border-bottom: 0;
    }

    .team-arrow {
      right: 50%;
      bottom: -14px;
      transform: translateX(50%) rotate(90deg);
    }

    .team-proof-grid {
      grid-template-columns: 1fr;
    }

    .team-price-card {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
  }

  @media (max-width: 720px) {
    .team-header-cta {
      display: none;
    }

    .team-hero {
      padding-top: 58px;
      padding-bottom: 54px;
    }

    .team-hero h1 {
      font-size: 48px;
    }

    .team-lead {
      font-size: 17px;
    }

    .team-actions,
    :global(.team-form-actions) {
      align-items: stretch;
      flex-direction: column;
    }

    .team-primary,
    .team-secondary,
    :global(.team-form-actions button) {
      width: 100%;
      justify-content: center;
      text-align: center;
    }

    .team-proof,
    .team-security,
    .team-pricing,
    .team-application {
      padding: 56px 24px;
    }

    .team-section-heading h2,
    .team-application h2 {
      font-size: 34px;
    }

    .team-proof-grid h3 {
      font-size: 24px;
    }

    .team-proof-grid img {
      height: 136px;
    }

    .team-price-card,
