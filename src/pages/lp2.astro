---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getDictionary } from "../i18n/getDictionary";
import { MAC_DOWNLOAD_URL, WIN_DOWNLOAD_URL } from "../lib/downloadAnalytics";

const lang = "ja" as const;
const dict = getDictionary(lang);
const compareRows = dict.Compare.rows.slice(0, 4);
const apps = [
  { name: "運営の打ち合わせ", mark: "運" },
  { name: "メンタリング", mark: "メ" },
  { name: "壁打ち・相談", mark: "壁" },
  { name: "勉強会", mark: "勉" },
  { name: "イベント", mark: "イ" },
  { name: "対面の会話", mark: "対" },
];
const issues = [
  {
    number: "01",
    title: "大事な相談が、会話の中に埋もれる",
    body: "メンタリングや壁打ちで生まれた気づきも、記録に残らなければ次の行動に活かしにくくなります。",
  },
  {
    number: "02",
    title: "運営と参加者の情報が、分かれていく",
    body: "オンライン・対面・複数のツールに会話が散らばると、コミュニティの文脈へ戻りづらくなります。",
  },
  {
    number: "03",
    title: "記録する人だけに、負担が集まる",
    body: "進行しながらメモを取り続けると、話す・聴く・考えることに集中しづらくなります。",
  },
];
const solutions = [
  {
    number: "01",
    label: "Capture",
    title: "運営の打ち合わせも、メンタリングも記録",
    body: "OSレベルで音声を拾うから、botを会議に招待する必要はありません。オンラインでも対面でも、いつもの場をそのまま記録できます。",
    points: ["会議ツールや場を選ばない", "bot招待や権限設定が不要"],
  },
  {
    number: "02",
    label: "Understand",
    title: "会話の要点を、次の行動につなげる",
    body: "録音した会話は、文字起こしと要約へ。運営の決定事項も、メンタリングで出た気づきも、あとから確認できます。",
    points: ["文字起こしは無料・無制限", "会話の要点をあとから確認"],
  },
  {
    number: "03",
    label: "Recall",
    title: "コミュニティの知見に、もう一度戻れる",
    body: "会話の記録を一箇所に集約。人、日付、発言内容を手がかりに、過去の相談や決定の文脈へ戻れます。",
    points: ["全議事録を横断検索", "Markdown / Obsidianへ出力"],
  },
];
---

<BaseLayout
  title="Reki note — スタートアップコミュニティを支える議事録ツール"
  description="運営の打ち合わせ、メンタリング、イベントの会話を、あとから使える記録に。Reki noteはスタートアップコミュニティを支える議事録ツールです。"
  lang={lang}
  canonical="https://rekinote.app/lp2/"
  noindex
  singleLang
>
  <div class="lp2-page">
    <header class="l-header">
      <div class="l-container l-header__inner">
        <a href="#top" class="c-brand" aria-label="Reki note ホーム">
          <img src="/logo.png" alt="" width="28" height="28" />
          <span>Reki note</span>
        </a>
        <nav class="c-nav" aria-label="メインナビゲーション">
          <a href="#solution">できること</a>
          <a href="#works-with">使える場面</a>
          <a href="#privacy">プライバシー</a>
          <a href="/ja/pricing/">料金</a>
        </nav>
        <div class="l-header__actions">
          <details class="c-mobile-nav">
            <summary aria-label="メニューを開く"><span class="c-mobile-nav__bars" aria-hidden="true"></span></summary>
            <nav class="c-mobile-nav__panel" aria-label="モバイルナビゲーション">
              <a href="#solution">できること</a>
              <a href="#works-with">使える場面</a>
              <a href="#privacy">プライバシー</a>
              <a href="/ja/pricing/">料金</a>
            </nav>
          </details>
          <a href="#download" class="c-button c-button--primary c-button--sm l-header__cta">無料ダウンロード</a>
        </div>
      </div>
    </header>

    <main id="top">
      <section class="p-hero" aria-labelledby="hero-title">
        <picture class="p-hero__background" aria-hidden="true">
          <source media="(max-width: 699px)" srcset="/images/reki-macbook-notes-real-ui-hero-640w.webp" type="image/webp" />
          <source media="(max-width: 1023px)" srcset="/images/reki-macbook-notes-real-ui-hero-960w.webp" type="image/webp" />
          <source srcset="/images/reki-macbook-notes-real-ui-hero-1536w.webp" type="image/webp" />
          <img
            src="/images/reki-macbook-notes-real-ui-hero-1536w.jpg"
            alt=""
            width="1536"
            height="1024"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
        <div class="p-hero__overlay" aria-hidden="true"></div>
        <div class="l-container p-hero__inner">
          <div class="p-hero__copy">
            <p class="p-hero__eyebrow">For Startup Communities</p>
            <h1 id="hero-title" class="p-hero__title">
              スタートアップ<br />
              <span>コミュニティを<br />支える</span><br />
              議事録ツール。
            </h1>
            <p class="p-hero__lead">
              <span class="p-hero__lead-group">運営会議・メンタリング・イベント。</span><br class="p-hero__lead-break" />
              コミュニティに生まれる会話を、あとから使える記録に。
            </p>
            <div class="p-hero__actions">
              <a href={MAC_DOWNLOAD_URL} class="c-button c-button--primary">Mac版を無料ダウンロード</a>
              <a href={WIN_DOWNLOAD_URL} class="c-button c-button--ghost">Windows版をダウンロード</a>
            </div>
            <p class="p-hero__note">Mac版はApple Silicon（M1以降）対応。Windows版は一部機能に制限があります。</p>
          </div>
        </div>
      </section>

      <section class="p-facts" aria-label="Reki noteの特徴">
        <div class="l-container p-facts__grid">
          <div class="p-facts__item">
            <span class="p-facts__check" aria-hidden="true">✓</span>
            <div><strong>無料・無制限</strong><span>文字起こし</span></div>
          </div>
          <div class="p-facts__item">
            <span class="p-facts__check" aria-hidden="true">✓</span>
            <div><strong>bot不要</strong><span>いつもの場で</span></div>
          </div>
          <div class="p-facts__item">
            <span class="p-facts__check" aria-hidden="true">✓</span>
            <div><strong>あとから探せる</strong><span>知見を記録に</span></div>
          </div>
        </div>
      </section>

      <section id="problem" class="l-section l-section--soft p-issues" aria-labelledby="issues-title">
        <div class="l-container">
          <div class="p-issues__intro">
            <header class="c-section-head">
              <p class="c-section-head__eyebrow">For Community Builders</p>
              <h2 id="issues-title" class="c-section-head__title">コミュニティの価値は、<br />会話の中にある。</h2>
              <p class="c-section-head__lead">運営会議、メンタリング、イベント。スタートアップの現場では、次の一手につながる会話が毎日生まれます。</p>
            </header>
            <figure class="p-issues__visual">
              <picture>
                <source media="(max-width: 699px)" srcset="/images/reki-startup-community-hero-640w.webp" type="image/webp" />
                <source srcset="/images/reki-startup-community-hero-1280w.webp" type="image/webp" />
                <img
                  src="/images/reki-startup-community-hero-1280w.jpg"
                  alt="スタートアップコミュニティの対話から、音声の流れが記録としてつながっていくイラスト"
                  width="1536"
                  height="1024"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
              <figcaption>会話が、次の一手につながる。</figcaption>
            </figure>
          </div>
          <ul class="p-issues__list">
            {issues.map((issue) => (
              <li class="p-issues__item">
                <span class="p-issues__number">{issue.number}</span>
                <h3>{issue.title}</h3>
                <p>{issue.body}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section id="solution" class="l-section p-solutions" aria-labelledby="solution-title">
        <div class="l-container">
          <header class="c-section-head c-section-head--center">
            <p class="c-section-head__eyebrow">Solution</p>
            <h2 id="solution-title" class="c-section-head__title">会話を、コミュニティの<br />資産に。</h2>
            <p class="c-section-head__lead">Reki noteは、コミュニティに生まれる会話を、録音から検索までひとつの流れに整えます。</p>
          </header>
          <ol class="p-solutions__list">
            {solutions.map((solution) => (
              <li class="p-solutions__item">
                <div class="p-solutions__top">
                  <span class="p-solutions__number">{solution.number}</span>
                  <span class="p-solutions__label">{solution.label}</span>
                </div>
                <h3>{solution.title}</h3>
                <p>{solution.body}</p>
                <ul>
                  {solution.points.map((point) => <li><span aria-hidden="true">✓</span>{point}</li>)}
                </ul>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section id="works-with" class="l-section l-section--soft p-works" aria-labelledby="works-title">
        <div class="l-container">
          <div class="p-works__layout">
            <header class="c-section-head">
              <p class="c-section-head__eyebrow">In The Community</p>
              <h2 id="works-title" class="c-section-head__title">コミュニティの、<br />いろいろな場面で。</h2>
              <p class="c-section-head__lead">OSレベルから音声を拾うので、会議ツールを選びません。運営、支援、交流の場にそのまま使えます。</p>
            </header>
            <ul class="p-works__grid">
              {apps.map((app) => (
                <li class="p-works__item">
                  <span class="p-works__mark" aria-hidden="true">{app.mark}</span>
                  <span>{app.name}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section id="how" class="l-section p-flow" aria-labelledby="flow-title">
        <div class="l-container">
          <header class="c-section-head c-section-head--center">
            <p class="c-section-head__eyebrow">How It Works</p>
            <h2 id="flow-title" class="c-section-head__title">会話を残すまで、<br />3ステップ。</h2>
            <p class="c-section-head__lead">場をつくる人も、参加する人も、記録に追われません。</p>
          </header>
          <ol class="p-flow__list">
            <li class="p-flow__item"><span>01</span><div><h3>いつもの場を始める</h3><p>Reki noteを起動して、運営会議やメンタリングを記録します。</p></div></li>
            <li class="p-flow__item"><span>02</span><div><h3>議事録をつくる</h3><p>音声から、あとで読み返せる文字起こしと要約ができあがります。</p></div></li>
            <li class="p-flow__item"><span>03</span><div><h3>次の人へつなぐ</h3><p>過去の会話を探したり、決定事項や学びをAIにたずねたりできます。</p></div></li>
          </ol>
        </div>
      </section>

      <section id="privacy" class="l-section l-section--cool p-privacy" aria-labelledby="privacy-title">
        <div class="l-container p-privacy__layout">
          <div>
            <header class="c-section-head">
              <p class="c-section-head__eyebrow">Privacy by Design</p>
              <h2 id="privacy-title" class="c-section-head__title">コミュニティの会話を、<br />安心して残す。</h2>
              <p class="c-section-head__lead">スタートアップの相談やアイデアを扱うからこそ、音声と生成データの保存場所を分けています。</p>
            </header>
            <ul class="p-privacy__facts">
              {dict.Privacy.facts.map((fact) => <li><span aria-hidden="true">✓</span>{fact}</li>)}
            </ul>
          </div>
          <div class="p-privacy__flow">
            <p class="p-privacy__flow-label">{dict.Privacy.providersLabel}</p>
            <p>{dict.Privacy.providersDesc}</p>
            <ol>
              {dict.Privacy.providers.map((provider, index) => <li><span>{String(index + 1).padStart(2, "0")}</span>{provider}</li>)}
            </ol>
          </div>
        </div>
      </section>

      <section class="l-section p-compare" aria-labelledby="compare-title">
        <div class="l-container">
          <header class="c-section-head c-section-head--center">
            <p class="c-section-head__eyebrow">Compare</p>
            <h2 id="compare-title" class="c-section-head__title">プラットフォームに閉じない、<br />コミュニティの記録。</h2>
          </header>
          <div class="p-compare__table-wrap">
            <table>
              <thead><tr><th>{dict.Compare.colFeature}</th><th>Reki note</th><th>{dict.Compare.col2}</th><th>{dict.Compare.col3}</th></tr></thead>
              <tbody>
                {compareRows.map((row) => (
                  <tr><th scope="row">{row.feature}</th><td class="is-good">{row.reki.text}</td><td>{row.otherAi.text}</td><td>{row.notes.text}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="p-compare__cards">
            {compareRows.map((row) => (
              <article class="p-compare__card">
                <h3>{row.feature}</h3>
                <div class="p-compare__card-value is-good">
                  <span>Reki note</span>
                  <p>{row.reki.text}</p>
                </div>
                <div class="p-compare__card-value">
                  <span>{dict.Compare.col2}</span>
                  <p>{row.otherAi.text}</p>
                </div>
                <div class="p-compare__card-value">
                  <span>{dict.Compare.col3}</span>
                  <p>{row.notes.text}</p>
                </div>
              </article>
            ))}
          </div>
          <p class="p-compare__note">{dict.Compare.footnote}</p>
        </div>
      </section>

      <section id="download" class="p-final-cta" aria-labelledby="final-title">
        <div class="l-container p-final-cta__inner">
          <p class="p-final-cta__eyebrow">Build The Next Memory</p>
          <h2 id="final-title" class="p-final-cta__title">次の会話から、<br />記録をはじめよう。</h2>
          <p class="p-final-cta__text">運営の打ち合わせも、メンタリングも、まずは無料で。Reki noteを一度の会話から試してみてください。</p>
          <div class="p-final-cta__actions">
            <a href={MAC_DOWNLOAD_URL} class="c-button c-button--light">Mac版を無料ダウンロード</a>
            <a href={WIN_DOWNLOAD_URL} class="c-button c-button--ghost">Windows版をダウンロード</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="p-footer">
      <div class="l-container p-footer__inner">
        <div class="p-footer__top">
          <a href="#top" class="c-brand c-brand--footer"><img src="/logo.png" alt="" width="24" height="24" /><span>Reki note</span></a>
          <p>スタートアップの会話を、次の挑戦につながる記録に。</p>
        </div>
        <div class="p-footer__bottom">
          <span>© 2026 HIBACHI inc.</span>
          <nav aria-label="フッターナビゲーション">
            <a href="https://hibachi-inc.jp">運営会社</a>
            <a href="/ja/legal/privacy/">プライバシーポリシー</a>
            <a href="/ja/legal/terms/">利用規約</a>
            <a href="/ja/legal/tokushoho/">特定商取引法に基づく表記</a>
          </nav>
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>

<style>
  :global(html) { scroll-behavior: smooth; }
  :global(body) { background: #ffffff !important; color: #0E2240 !important; }

  .lp2-page {
    --primary: #0E2240;
    --primary-hover: #091A31;
    --primary-deep: #07172C;
    --brand-blue: #3E6F9D;
    --brand-aqua: #167A93;
    --gradient-brand: linear-gradient(115deg, #0E2240 0%, #163D69 54%, #267A92 100%);
    --text: #0E2240;
    --muted: #5A6B80;
    --soft: #F3F6F9;
    --cool: #EAF2F8;
    --tint: #EFF7FA;
    --border: #D6E1EC;
    --shadow: 0 3px 10px rgba(14, 34, 64, 0.12), 0 20px 44px rgba(23, 102, 130, 0.09);
    --shadow-strong: 0 8px 20px rgba(14, 34, 64, 0.18), 0 28px 60px rgba(23, 102, 130, 0.13);
    min-height: 100vh;
    overflow: hidden;
    color: var(--text);
    background: #fff;
    font-family: 'Noto Sans JP', 'Hiragino Kaku Gothic ProN', 'ヒラギノ角ゴ ProN W3', sans-serif;
    font-size: 16px;
    line-height: 1.8;
    letter-spacing: 0.01em;
    word-break: normal;
    overflow-wrap: anywhere;
    font-feature-settings: normal;
    -webkit-font-smoothing: antialiased;
  }

  .lp2-page *, .lp2-page *::before, .lp2-page *::after { box-sizing: border-box; }
  .lp2-page img, .lp2-page svg { display: block; max-width: 100%; }
  .lp2-page a { color: inherit; text-decoration: none; }
  .lp2-page ul, .lp2-page ol { list-style: none; margin: 0; padding: 0; }
  .lp2-page h1, .lp2-page h2, .lp2-page h3, .lp2-page p, .lp2-page figure { margin: 0; }
  .lp2-page h1, .lp2-page h2, .lp2-page h3 { font-feature-settings: "palt" 1; font-kerning: normal; letter-spacing: 0.02em; }
  .lp2-page :focus-visible { outline: 3px solid var(--brand-aqua); outline-offset: 4px; }

  .l-container { width: 100%; max-width: 1120px; margin: 0 auto; padding: 0 24px; }
  .l-header { position: sticky; top: 0; z-index: 20; background: rgba(255,255,255,.94); border-bottom: 1px solid var(--border); backdrop-filter: saturate(160%) blur(10px); }
  .l-header__inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 72px; }
  .l-header__actions { display: flex; align-items: center; gap: 8px; }
  .c-brand { display: inline-flex; align-items: center; gap: 10px; color: var(--primary); font-family: Inter, 'Helvetica Neue', Arial, sans-serif; font-size: 20px; font-weight: 700; letter-spacing: .02em; }
  .c-brand img { border-radius: 7px; }
  .c-nav { display: none; align-items: center; gap: 28px; margin-left: auto; margin-right: 8px; color: var(--muted); font-size: 14px; font-weight: 500; }
  .c-nav a { transition: color .2s ease; }
  .c-nav a:hover { color: var(--primary); }

  .c-button { display: inline-flex; align-items: center; justify-content: center; min-height: 52px; padding: 12px 22px; border-radius: 10px; font-weight: 500; line-height: 1.4; text-align: center; transition: background-color .2s ease, color .2s ease, border-color .2s ease, box-shadow .2s ease, transform .15s ease; }
  .c-button:hover { transform: translateY(-1px); }
  .c-button--primary { background: var(--primary); color: #fff !important; box-shadow: 0 8px 22px rgba(14,34,64,.2); }
  .c-button--primary:hover { background: var(--primary-hover); box-shadow: 0 10px 24px rgba(14,34,64,.3); }
  .c-button--ghost { border: 1px solid rgba(255,255,255,.7); color: #fff; background: transparent; }
  .c-button--ghost:hover { border-color: #fff; background: rgba(255,255,255,.12); }
  .c-button--light { background: #fff; color: var(--primary) !important; box-shadow: 0 8px 22px rgba(7,23,44,.2); }
  .c-button--light:hover { background: var(--cool); }
  .c-button--sm { min-height: 40px; padding: 9px 16px; font-size: 14px; }

  .p-hero { position: relative; isolation: isolate; min-height: 760px; overflow: hidden; padding: 0; color: #fff; background: var(--primary-deep); }
  .p-hero::before { content: ''; position: absolute; inset: 0; z-index: -1; opacity: .22; background-image: linear-gradient(rgba(255,255,255,.32) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.32) 1px, transparent 1px); background-size: 56px 56px; mask-image: linear-gradient(90deg, #000, transparent 80%); }
  .p-hero__background { position: absolute; inset: 0; z-index: -2; }
  .p-hero__background img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center center; }
  .p-hero__overlay { position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(7,23,44,.9) 0%, rgba(7,23,44,.72) 35%, rgba(7,23,44,.22) 70%, rgba(7,23,44,.08) 100%); }
  .p-hero__inner { position: relative; z-index: 1; display: flex; align-items: center; min-height: 760px; }
  .p-hero__copy { max-width: 620px; }
  .p-hero__eyebrow, .c-section-head__eyebrow, .p-solutions__label, .p-privacy__flow-label, .p-final-cta__eyebrow { color: var(--primary); font-family: Inter, 'Helvetica Neue', Arial, sans-serif; font-size: 12px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; }
  .p-hero__eyebrow, .p-final-cta__eyebrow { color: rgba(255,255,255,.76); }
  .p-hero__title { margin-top: 14px; color: #fff; font-size: clamp(2.4rem, 7vw, 4.25rem); font-weight: 900; line-height: 1.28; text-shadow: 0 4px 18px rgba(7,23,44,.22); }
  .p-hero__title span { color: #D8F1F4; }
  .p-hero__lead { max-width: 560px; margin-top: 20px; color: rgba(255,255,255,.9); font-size: 18px; line-height: 1.9; }
  .p-hero__lead-group { white-space: nowrap; }
  .p-hero__lead-break { display: block; }
  .p-hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .p-hero__note { margin-top: 14px; color: rgba(255,255,255,.72); font-size: 12px; line-height: 1.7; }

  .p-facts { background: #fff; border-bottom: 1px solid var(--border); }
